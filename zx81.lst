0830  DB $0F,$0F,$0F,$0F,$F0,$F0,$F0,$F0
0838  DB $FF,$FF,$FF,$FF,$F0,$F0,$F0,$F0
0840  DB $AA,$55,$AA,$55,$AA,$55,$AA,$55
0848  DB $00,$00,$00,$00,$AA,$55,$AA,$55
0850  DB $AA,$55,$AA,$55,$00,$00,$00,$00
0858  ; $0B quote
