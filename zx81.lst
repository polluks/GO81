0870  ; $0E colon
0870  DB $00,$00,$00,$10,$00,$00,$10,$00
0878  ; $0F question
0878  DB $00,$3C,$42,$04,$08,$00,$08,$00
0880  ; $10 lparen
0880  DB $00,$04,$08,$08,$08,$08,$04,$00
0888  ; $11 rparen
