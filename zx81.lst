0727  ; ===== DISPLAY UPDATE =====
0727  UPDATE_DISPLAY:
0727              LD IX,$5000
072B              LD IY,$8000
072F              LD B,ZX_ROWS
0731  UD_ROW:     LD A,(IX+0)
0734              CP ZX_NL
0736              JR NZ,UD_CO
0738              INC IX
073A  UD_CO:      PUSH BC
073B              LD B,ZX_COLS
073D  UD_CH:      LD A,(IX+0)
0740              CP $00
0742              JR Z,UD_SP
0744              CP ZX_NL
0746              JR Z,UD_SP
0748              AND $3F
074A              JR UD_WR
074C  UD_SP:      LD A,$20
074E  UD_WR:      LD (IY+0),A
0751              INC IX
0753              INC IY
0755              DJNZ UD_CH
0757              LD A,(IX+0)
075A              CP ZX_NL
075C              JR NZ,UD_NX
075E              INC IX
0760  UD_NX:      POP BC
0761              DJNZ UD_ROW
0763              RET
