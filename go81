10 REM ==============================================
20 REM GO81 - ZX81 ON COMMODORE 128 (BASIC 7.0 BOOT)
30 REM ==============================================
40 COLOR 0,1: COLOR 4,1: COLOR 1,7: REM BLACK BORDER, WHITE BG, BLACK TEXT
50 SCNCLR
60 PRINT "GO81 - SINCLAIR ZX81 FOR COMMODORE 128"
70 PRINT "INITIALIZING Z80 MODE..."
80 REM FILL VIC COLOR RAM ($D800-$DBE7) WITH BLACK ($00)
90 BANK 15
100 FOR I = 55296 TO 56319: POKE I, 0: NEXT I
110 REM LOAD Z80 BINARY TO BANK 0 STARTING AT $0000
120 PRINT "LOADING ZX81 BINARY..."
130 BLOAD "ZX81.BIN",B0,P0
140 REM SETUP 8502-TO-Z80 SWITCH ROUTINE AT $0E00 (3584)
150 BANK 0
160 FOR I = 0 TO 44
170   READ B
180   POKE 3584 + I, B
190 NEXT I
200 PRINT "STARTING Z80..."
210 SYS 3584
220 PRINT "RETURNED TO 8502."
230 END
240 REM 8502 MACHINE CODE ROUTINE TO SWITCH TO Z80 AT $0000:
250 REM 0E00: AD 00 FF    LDA $FF00     ; SAVE MMU CONFIG
260 REM 0E03: 48          PHA
270 REM 0E04: 78          SEI           ; DISABLE INTERRUPTS
280 REM 0E05: A9 C3       LDA #$C3      ; JP OPCODE
290 REM 0E07: 8D EE FF    STA $FFEE     ; BOOT LINK VECTOR
300 REM 0E0A: A9 00       LDA #$00      ; LOW BYTE OF $0000
310 REM 0E0C: 8D EF FF    STA $FFEF
320 REM 0E0F: A9 00       LDA #$00      ; HIGH BYTE OF $0000
330 REM 0E11: 8D F0 FF    STA $FFF0
340 REM 0E14: A9 3E       LDA #$3E      ; MMU: RAM BANK 0, ALL RAM
350 REM 0E16: 8D 00 FF    STA $FF00
360 REM 0E19: AD 05 D5    LDA $D505     ; SAVE MODE CONFIG
370 REM 0E1C: 48          PHA
380 REM 0E1D: A9 B0       LDA #$B0      ; ACTIVATE Z80
390 REM 0E1F: 8D 05 D5    STA $D505
400 REM 0E22: EA          NOP           ; DELAY FOR 8502 RECOVERY
410 REM 0E23: 68          PLA           ; RESTORE MODE CONFIG
420 REM 0E24: 8D 05 D5    STA $D505
430 REM 0E27: 68          PLA           ; RESTORE MMU
440 REM 0E28: 8D 00 FF    STA $FF00
450 REM 0E2B: 58          CLI           ; ENABLE INTERRUPTS
460 REM 0E2C: 60          RTS
470 DATA 173,0,255,72,120,169,195,141,238,255,169,0,141,239,255,169,0,141,240,255
