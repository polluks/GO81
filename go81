10 REM ==============================================
20 REM GO81 - ZX81 ON COMMODORE 128 (BASIC 7.0 BOOT)
30 REM ==============================================
40 COLOR 0,1: COLOR 4,1: COLOR 1,7: REM BLACK BORDER, WHITE BG, BLACK TEXT
50 SCNCLR
60 PRINT "GO81 - SINCLAIR ZX81 FOR COMMODORE 128"
70 PRINT "INITIALIZING SCREEN AND COLOR RAM..."
80 REM FILL VIC COLOR RAM ($D800-$DBE7) WITH BLACK ($00)
90 BANK 15
100 FOR I = 55296 TO 56319: POKE I, 0: NEXT I
110 REM BLOAD TO SAFE STAGING AREA AT $2000 (8192) IN BANK 0
120 REM (LOADING DIRECTLY TO $0000 WOULD CRASH ZERO-PAGE/STACK)
130 PRINT "LOADING ZX81.BIN TO STAGING AREA ($2000)..."
140 BLOAD "ZX81.BIN",B0,P8192
150 REM SETUP 8502 RELOCATOR & Z80 BOOT ROUTINE AT $4000 (16384)
160 REM (PLACED ABOVE $2000 STAGING AREA SO IT NEVER OVERWRITES ITSELF)
170 BANK 0
180 FOR I = 0 TO 53
190   READ B
200   POKE 16384 + I, B
210 NEXT I
220 PRINT "RELOCATING TO $0000 AND STARTING Z80..."
230 SYS 16384
240 PRINT "RETURNED TO 8502."
250 END
260 REM ----------------------------------------------------
270 REM 8502 MACHINE CODE ROUTINE AT $4000 (16384):
280 REM 4000: 78          SEI           ; DISABLE INTERRUPTS
290 REM 4001: A9 3E       LDA #$3E      ; MMU: BANK 0 ALL RAM
300 REM 4003: 8D 00 FF    STA $FF00
310 REM 4006: A2 20       LDX #$20      ; COPY 32 PAGES (8KB)
320 REM 4008: A0 00       LDY #$00
330 REM 400A: B9 00 20    LDA $2000,Y   ; SRC (SELF-MODIFYING HI-BYTE)
340 REM 400D: 99 00 00    STA $0000,Y   ; DST (SELF-MODIFYING HI-BYTE)
350 REM 4010: C8          INY
360 REM 4011: D0 F7       BNE $400A
370 REM 4013: EE 0C 40    INC $400C     ; INC SRC HI-BYTE
380 REM 4016: EE 0F 40    INC $400F     ; INC DST HI-BYTE
390 REM 4019: CA          DEX
400 REM 401A: D0 EE       BNE $400A
410 REM 401C: A9 C3       LDA #$C3      ; Z80 JP OPCODE
420 REM 401E: 8D EE FF    STA $FFEE     ; BOOT LINK VECTOR
430 REM 4021: A9 00       LDA #$00      ; ADDRESS $0000
440 REM 4023: 8D EF FF    STA $FFEF
450 REM 4026: 8D F0 FF    STA $FFF0
460 REM 4029: A9 B0       LDA #$B0      ; SWITCH TO Z80 CPU
470 REM 402B: 8D 05 D5    STA $D505
480 REM 402E: EA          NOP           ; DELAY FOR 8502 RESTORE
490 REM 402F: A9 00       LDA #$00      ; RESTORE NORMAL MMU CONFIG
500 REM 4031: 8D 00 FF    STA $FF00
510 REM 4034: 58          CLI           ; RE-ENABLE INTERRUPTS
520 REM 4035: 60          RTS
530 REM ----------------------------------------------------
